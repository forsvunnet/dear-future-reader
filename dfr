#!/usr/bin/env bash
# Runs a dfr command as an artisan command with the "dfr:" prefix.
# The current folder stays the same, because git:add reads the git repository in it.
set -euo pipefail

root="$(dirname "$(realpath "$0")")"
artisan="$root/artisan"

case "${1:-}" in
    "" | -h | --help)
        exec php "$artisan" list dfr
        ;;
    -*)
        exec php "$artisan" "$@"
        ;;
    init | list | search)
        command="$1"
        shift
        exec php "$artisan" "dfr:$command" "$@"
        ;;
esac

# All other commands work on one thing: dfr $ID COMMAND [ARGUMENTS...]
if [ $# -lt 2 ]; then
    echo "dfr: give a command after the ID." >&2
    exit 1
fi

id="$1"
command="$2"
shift 2
exec php "$artisan" "dfr:$command" "$id" "$@"
