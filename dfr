#!/usr/bin/env bash
# Runs a dfr command as an artisan command with the "dfr:" prefix.
# The current folder stays the same, because git:add reads the git repository in it.
set -euo pipefail

# laravel/pao removes tabs and blank lines from artisan output when an agent runs it.
# The output of dfr is file content and columns, so it must stay exact.
export PAO_DISABLE=1

root="$(dirname "$(realpath "$0")")"
artisan="$root/artisan"

case "${1:-}" in
    "" | -h | --help)
        exec php "$artisan" list dfr
        ;;
    -*)
        exec php "$artisan" "$@"
        ;;
    init | list | search)
        command="$1"
        shift
        exec php "$artisan" "dfr:$command" "$@"
        ;;
esac

# All other commands work on one thing: dfr $ID COMMAND [ARGUMENTS...]
if [ $# -lt 2 ]; then
    echo "dfr: give a command after the ID." >&2
    exit 1
fi

id="$1"
command="$2"
shift 2

# The todo commands have two words: dfr $ID todo add [ITEM...]
if [ "$command" = todo ]; then
    if [ $# -lt 1 ]; then
        echo "dfr: give a todo command, like add, tick or next." >&2
        exit 1
    fi
    command="todo:$1"
    shift
fi

exec php "$artisan" "dfr:$command" "$id" "$@"
